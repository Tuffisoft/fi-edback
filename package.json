{
  "name": "fi-edback",
  "version": "0.4.2",
  "description": "Reusable visual feedback widget for Next.js Vercel preview deployments",
  "author": "Studio Fi<fi@studio-fi.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tuffisoft/fi-edback.git"
  },
  "keywords": [
    "nextjs",
    "feedback",
    "preview",
    "widget",
    "visual-feedback"
  ],
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js",
      "default": "./dist/index.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "require": "./dist/client.cjs",
      "import": "./dist/client.js",
      "default": "./dist/client.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "pack": "npm pack",
    "dev": "cd dev && npm run dev",
    "typecheck": "tsc --noEmit",
    "dev:refresh": "npm run build && npm pack && cd dev && npm i && npm run dev"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.9.0",
    "zod": "~3.23.8"
  },
  "overrides": {
    "zod": "~3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tsup": "^8.0.0",
    "typescript": "^5"
  },
  "peerDependencies": {
    "next": ">=15.0.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  }
}
